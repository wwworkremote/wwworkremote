<%= render "admin/shared/nav" %>
<div class="mb-8"><h1 class="text-3xl font-black text-white">Resume refreshes</h1><p class="text-slate-400">Review provider changes before they touch your curated profile.</p></div>
<%= button_to "Create refresh preview", admin_resume_refreshes_path, method: :post, class: "btn-neural mb-6" %>
<div class="space-y-4">
  <% @refreshes.each do |refresh| %>
    <section class="card-neural p-6">
      <div class="flex justify-between"><h2 class="font-bold text-white"><%= refresh.provider %> · <%= refresh.status.humanize %></h2><span class="text-xs text-slate-500"><%= refresh.created_at.iso8601 %></span></div>
      <% positions = refresh.plan.fetch("positions", {}) %>
      <p class="mt-3 text-sm text-slate-300">Positions: <%= positions.fetch("added", []).size %> added · <%= positions.fetch("changed", []).size %> changed · <%= positions.fetch("removed", []).size %> removed</p>
      <% if refresh.status == "pending" %>
        <div class="mt-4 flex gap-3"><%= button_to "Approve additions and changes", approve_admin_resume_refresh_path(refresh), method: :post, class: "btn-neural bg-emerald-500/10 text-emerald-400" %><%= button_to "Approve including removals", approve_admin_resume_refresh_path(refresh), method: :post, params: { confirm_removals: "1" }, data: { turbo_confirm: "This permanently removes #{positions.fetch('removed', []).size} stored experience(s). Continue?" }, class: "btn-neural bg-amber-500/10 text-amber-400" if positions.fetch("removed", []).any? %><%= button_to "Reject", reject_admin_resume_refresh_path(refresh), method: :post, class: "btn-neural bg-rose-500/10 text-rose-400" %></div>
      <% end %>
    </section>
  <% end %>
</div>
